generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  firebaseUid        String               @unique
  email              String               @unique
  name               String
  role               UserRole?
  avatarUrl          String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  conversations      AIConversation[]
  auditLogs          AuditLog[]
  events             CalendarEvent[]
  collaborations     CaseCollaborator[]
  lawyerProfile      LawyerProfile?
  notifications      Notification[]
  studentProfile     StudentProfile?
  assignedTasks      Task[]               @relation("AssignedTasks")
  createdTasks       Task[]               @relation("CreatedTasks")
  simulationSessions SimulationSession[]
  caseDocuments      CaseDocument[]
  caseNotes          CaseNote[]
  caseFacts          CaseFact[]
  caseParties        CaseParty[]
  caseResearches     CaseResearch[]
  CaseIntelligence   CaseIntelligence[]
  HearingPreparation HearingPreparation[]
}

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  university  String
  course      String
  yearOfStudy Int
  interests   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LawyerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  specialization    String
  experienceYears   Int
  bio               String?
  location          String
  professionalTitle String
  enrollmentNumber  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Case {
  id                 String               @id @default(uuid())
  caseNumber         String               @unique
  title              String
  description        String?
  caseType           CaseType
  status             CaseStatus           @default(ACTIVE)
  priority           CasePriority         @default(MEDIUM)
  court              String
  clientName         String
  opposingParty      String
  nextHearingAt      DateTime?
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  events             CalendarEvent[]
  collaborators      CaseCollaborator[]
  tasks              Task[]
  documents          CaseDocument[]
  notes              CaseNote[]
  facts              CaseFact[]
  parties            CaseParty[]
  researches         CaseResearch[]
  conversations      AIConversation[]
  intelligence       CaseIntelligence?
  HearingPreparation HearingPreparation[]
}

model CaseFact {
  id          String   @id @default(uuid())
  caseId      String
  title       String
  description String?
  isImportant Boolean  @default(false)
  orderIndex  Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model CaseParty {
  id          String   @id @default(uuid())
  caseId      String
  name        String
  partyType   String   @default("PETITIONER")
  role        String?
  contactInfo String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model CaseResearch {
  id          String   @id @default(uuid())
  caseId      String
  query       String
  aiAnalysis  String
  sources     String?
  citations   String?
  createdById String
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id           String            @id @default(uuid())
  caseId       String
  name         String
  fileUrl      String
  fileType     String
  fileSize     Int
  textContent  String?
  uploadedById String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  case         Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy   User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  analysis     DocumentAnalysis?
}

model DocumentAnalysis {
  id                  String       @id @default(uuid())
  documentId          String       @unique
  summary             String
  keyFacts            String?
  legalIssues         String?
  statutoryProvisions String?
  arguments           String?
  precedents          String?
  importantDates      String?
  parties             String?
  evidence            String?
  followUpResearch    String?
  rawAnalysis         String?
  analyzedById        String
  createdAt           DateTime     @default(now())
  document            CaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model CaseIntelligence {
  id                  String   @id @default(uuid())
  caseId              String   @unique
  summary             String
  legalIssues         String[]
  keyFacts            String[]
  statutes            String[]
  precedents          String[]
  supportingArguments String[]
  opposingArguments   String[]
  evidenceGaps        String[]
  contradictions      String[]
  researchAreas       String[]
  actionItems         String[]
  importantDates      String[]
  generatedAt         DateTime @default(now())
  generatedById       String

  case        Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  generatedBy User @relation(fields: [generatedById], references: [id], onDelete: Cascade)
}

model CaseNote {
  id          String   @id @default(uuid())
  caseId      String
  title       String
  content     String
  isPrivate   Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model CaseCollaborator {
  id        String           @id @default(uuid())
  caseId    String
  userId    String
  role      CollaboratorRole
  createdAt DateTime         @default(now())
  case      Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     CasePriority @default(MEDIUM)
  dueAt        DateTime?
  assignedToId String?
  createdById  String
  caseId       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  case         Case?        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id          String              @id @default(uuid())
  title       String
  description String?
  type        EventType
  startAt     DateTime
  endAt       DateTime
  location    String?
  caseId      String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  case        Case?               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  hearingPrep HearingPreparation?
}

model HearingPreparation {
  id                  String   @id @default(uuid())
  eventId             String   @unique
  caseId              String
  summary             String
  disputedIssues      String[]
  keyFacts            String[]
  legalAuthorities    String[]
  evidenceToReview    String[]
  supportingArguments String[]
  opposingArguments   String[]
  questionsToPrepare  String[]
  pendingTasks        String[]
  checklist           String[]
  generatedAt         DateTime @default(now())
  generatedById       String

  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  case        Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  generatedBy User          @relation(fields: [generatedById], references: [id], onDelete: Cascade)
}

model Notification {
  id                String   @id @default(uuid())
  userId            String
  type              String
  title             String
  message           String
  isRead            Boolean  @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  caseId    String?
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  case      Case?       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

enum UserRole {
  STUDENT
  LAWYER
  ADMIN
}

enum CaseStatus {
  ACTIVE
  PENDING
  DISPOSED
  ARCHIVED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CaseType {
  CRIMINAL
  CIVIL
  CORPORATE
  CONSTITUTIONAL
  INTELLECTUAL_PROPERTY
  FAMILY
  OTHER
}

enum CollaboratorRole {
  LEAD_LAWYER
  ASSOCIATE
  JUNIOR
  CONSULTANT
  VIEWER
}

enum EventType {
  HEARING
  MEETING
  DEADLINE
  REMINDER
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model CaseScenario {
  id           String              @id @default(uuid())
  title        String
  practiceArea String
  difficulty   String
  summary      String
  facts        String
  parties      String
  legalIssues  String
  evidence     String
  relevantLaw  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sessions     SimulationSession[]
}

model SimulationSession {
  id             String                @id @default(uuid())
  userId         String
  caseScenarioId String
  status         String                @default("IN_PROGRESS")
  currentStage   String                @default("CASE_BRIEF")
  overallScore   Int?
  startedAt      DateTime              @default(now())
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseScenario   CaseScenario          @relation(fields: [caseScenarioId], references: [id], onDelete: Cascade)
  responses      SimulationResponse[]
  evaluation     SimulationEvaluation?
}

model SimulationResponse {
  id              String            @id @default(uuid())
  sessionId       String
  stage           String
  prompt          String
  studentResponse String
  aiFeedback      String?
  createdAt       DateTime          @default(now())
  session         SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SimulationEvaluation {
  id                           String            @id @default(uuid())
  sessionId                    String            @unique
  legalReasoningScore          Int
  issueIdentificationScore     Int
  evidenceHandlingScore        Int
  argumentationScore           Int
  proceduralAwarenessScore     Int
  counterargumentHandlingScore Int
  strategyScore                Int
  overallScore                 Int
  strengths                    String
  weaknesses                   String
  missedIssues                 String
  recommendations              String
  simulatedJudgment            String
  createdAt                    DateTime          @default(now())
  session                      SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
